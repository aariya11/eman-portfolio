# Privacy-Conscious Google Analytics 4 (Optional — leave blank to disable tracking)
NEXT_PUBLIC_GA_ID=

# Search Console Verification Tokens (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
